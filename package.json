{
    "name": "coc-spring-dashboard",
    "version": "0.4.0",
    "description": "Spring Boot dashboard for coc.nvim",
    "author": "Svetlozar Iliev <svetlozar321@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/asmodeus812/coc-spring-dashboard"
    },
    "main": "lib/index.js",
    "keywords": [
        "coc.nvim"
    ],
    "engines": {
        "coc": "^0.0.82"
    },
    "extensionDependencies": [
        "coc-java",
        "coc-springboot"
    ],
    "activationEvents": [
        "onLanguage:java"
    ],
    "scripts": {
        "build": "node esbuild.mjs",
        "prepare": "node esbuild.mjs",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "coc.nvim": "^0.0.83-next.18",
        "esbuild": "^0.19.8",
        "typescript": "^5.3.3"
    },
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "Spring Boot Dashboard",
            "properties": {
                "spring.dashboard.openUrl": {
                    "type": "string",
                    "default": "{protocol}://{hostname}:{port}{contextPath}",
                    "description": "Url template of an app, {protocol} {hostname} {port} {contextPath}"
                },
                "spring.dashboard.memory-view.fetch-data.delay-in-milliseconds": {
                    "type": "number",
                    "default": 5000,
                    "description": "Interval of the memory metrics poll"
                },
                "spring.dashboard.memory-view.display-data.max-datapoints": {
                    "type": "number",
                    "default": 10,
                    "description": "Width of the memory sparklines"
                },
                "spring.dashboard.enableGutter": {
                    "type": "string",
                    "enum": [
                        "on",
                        "off"
                    ],
                    "default": "on",
                    "description": "Signs on the bean definitions and request mappings"
                },
                "spring.dashboard.debug.attachTimeout": {
                    "type": "number",
                    "default": 30,
                    "description": "Seconds to wait for a debugger to attach to a debugged app, the app is killed after that"
                },
                "spring.dashboard.stop.gracePeriod": {
                    "type": "number",
                    "default": 10,
                    "description": "Seconds an app gets to shut down after Stop (SIGTERM) before it is killed (SIGKILL)"
                },
                "spring.dashboard.launch.prompt": {
                    "type": "string",
                    "enum": [
                        "first",
                        "always",
                        "never"
                    ],
                    "default": "always",
                    "description": "When the launch panel opens: the first time per app (then the remembered settings are used), every time (default), or never"
                },
                "spring.dashboard.layout.terminalHeight": {
                    "type": "number",
                    "default": 65,
                    "minimum": 10,
                    "maximum": 90,
                    "description": "Percent of the height of an app dashboard tab given to the terminal under the views"
                },
                "spring.dashboard.layout.components": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "beans",
                            "endpoints",
                            "properties",
                            "memory",
                            "terminal"
                        ]
                    },
                    "uniqueItems": true,
                    "default": [
                        "beans",
                        "endpoints",
                        "properties",
                        "memory",
                        "terminal"
                    ],
                    "description": "The panes of an app dashboard tab, in their fixed places: the views side by side on top, the terminal below. A left out view is not shown anywhere, a left out terminal keeps running without a window. An empty list is all of them"
                },
                "spring.dashboard.layout.cleanup": {
                    "type": "string",
                    "enum": [
                        "always",
                        "keep"
                    ],
                    "default": "always",
                    "description": "When an app stops: close its dashboard tab (always), or keep the tab for the next run (keep)"
                },
                "spring.dashboard.layout.fallbackSize": {
                    "type": "number",
                    "default": 75,
                    "minimum": 20,
                    "maximum": 100,
                    "description": "Width and height, in percent of the screen, of the float a bean, an endpoint, a relation or an nvim-dap stop opens in when the app has no source window, or there is no app"
                },
                "spring.dashboard.apps": {
                    "type": "object",
                    "default": {},
                    "description": "Default launch settings per app name, used until the launch panel remembers others: { \"my-app\": { \"profiles\": [\"dev\"], \"port\": \"0\", \"logLevel\": \"INFO\", \"logPackages\": \"com.example=DEBUG\", \"debugReport\": false, \"vmArgs\": \"-Xmx512m\", \"args\": \"\", \"env\": \"KEY=VALUE\" } }",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "profiles": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "port": {
                                "type": "string"
                            },
                            "logLevel": {
                                "type": "string"
                            },
                            "logPackages": {
                                "type": "string"
                            },
                            "debugReport": {
                                "type": "boolean"
                            },
                            "vmArgs": {
                                "type": "string"
                            },
                            "args": {
                                "type": "string"
                            },
                            "env": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "commands": [
            {
                "command": "spring-boot-dashboard.refresh",
                "title": "Refresh the apps",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.localapp.run",
                "title": "Run app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.localapp.runWithProfile",
                "title": "Run app with profiles",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.localapp.debug",
                "title": "Debug app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.localapp.debugWithProfile",
                "title": "Debug app with profiles",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.localapp.settings",
                "title": "Edit the launch settings of an app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.localapp.dashboard",
                "title": "Show the dashboard tab of an app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.localapp.attach",
                "title": "Attach the debugger to a running app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.attach",
                "title": "Attach to an app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.localapp.stop",
                "title": "Stop app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.localapp.open",
                "title": "Open a running app in the browser",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.livedata.refresh",
                "title": "Refresh the live data",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.apps.focus",
                "title": "Focus the apps view",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.navigate",
                "title": "Go to the bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.open",
                "title": "Open the bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showAll",
                "title": "Show all beans",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showDefined",
                "title": "Show only the beans defined in the workspace",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showDependencies",
                "title": "Show the dependencies of the bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showInjectedInto",
                "title": "Show where the bean is injected",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showHierarchy",
                "title": "Show the hierarchy of the bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.beans.find",
                "title": "Find a bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.staticData.refresh",
                "title": "Refresh the beans and mappings of the workspace",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.endpoint.navigate",
                "title": "Go to the endpoint",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.endpoint.open",
                "title": "Open the endpoint in the browser",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.mapping.showAll",
                "title": "Show all mappings",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.mapping.showDefined",
                "title": "Show only the mappings defined in the workspace",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.mappings.find",
                "title": "Find a mapping",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.properties.find",
                "title": "Find a property",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.remoteApp.connect",
                "title": "Connect a remote app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.remoteApp.disconnect",
                "title": "Disconnect a remote app",
                "category": "Spring Boot Dashboard"
            }
        ]
    }
}
