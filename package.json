{
    "name": "coc-spring-dashboard",
    "version": "0.4.2",
    "description": "Spring Boot dashboard for coc.nvim",
    "author": "Svetlozar Iliev <svetlozar321@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/asmodeus812/coc-spring-dashboard"
    },
    "main": "lib/index.js",
    "keywords": [
        "coc.nvim"
    ],
    "engines": {
        "coc": "^0.0.82"
    },
    "extensionDependencies": [
        "coc-java",
        "coc-springboot"
    ],
    "activationEvents": [
        "onLanguage:java"
    ],
    "scripts": {
        "build": "node esbuild.mjs",
        "prepare": "node esbuild.mjs",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "coc.nvim": "^0.0.83-next.18",
        "esbuild": "^0.19.8",
        "typescript": "^5.3.3"
    },
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "Spring Boot Dashboard",
            "properties": {
                "spring.dashboard.openUrl": {
                    "type": "string",
                    "default": "{protocol}://{hostname}:{port}{contextPath}",
                    "description": "Url template of an app, {protocol} {hostname} {port} {contextPath}"
                },
                "spring.dashboard.memory-view.fetch-data.delay-in-milliseconds": {
                    "type": "number",
                    "default": 5000,
                    "description": "Interval of the memory metrics poll"
                },
                "spring.dashboard.memory-view.display-data.max-datapoints": {
                    "type": "number",
                    "default": 10,
                    "description": "Width of the memory sparklines"
                },
                "spring.dashboard.enableGutter": {
                    "type": "string",
                    "enum": [
                        "on",
                        "off"
                    ],
                    "default": "on",
                    "description": "Signs on the bean definitions and request mappings"
                },
                "spring.dashboard.debug.attachTimeout": {
                    "type": "number",
                    "default": 30,
                    "description": "Seconds to wait for the debugger to attach (Debug, Attach debugger, Attach to a remote app); an app started with Debug is stopped after that, the others keep running"
                },
                "spring.dashboard.stop.gracePeriod": {
                    "type": "number",
                    "default": 10,
                    "description": "Seconds an app gets to shut down after Stop (SIGTERM) before it is killed (SIGKILL)"
                },
                "spring.dashboard.launch.prompt": {
                    "type": "string",
                    "enum": [
                        "first",
                        "always",
                        "never"
                    ],
                    "default": "always",
                    "description": "When the launch panel opens: the first time per app (then the remembered settings are used), every time (default), or never"
                },
                "spring.dashboard.layout.terminalHeight": {
                    "type": "number",
                    "default": 65,
                    "minimum": 10,
                    "maximum": 90,
                    "description": "Percent of the height of an app dashboard tab given to the terminal under the views"
                },
                "spring.dashboard.layout.components": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "beans",
                            "endpoints",
                            "properties",
                            "memory",
                            "terminal"
                        ]
                    },
                    "uniqueItems": true,
                    "default": [
                        "beans",
                        "endpoints",
                        "properties",
                        "memory",
                        "terminal"
                    ],
                    "description": "The panes of an app dashboard tab, in their fixed places: the views side by side on top, the terminal below. A left out view is not shown anywhere, a left out terminal keeps running without a window. An empty list is all of them"
                },
                "spring.dashboard.layout.cleanup": {
                    "type": "string",
                    "enum": [
                        "always",
                        "keep"
                    ],
                    "default": "always",
                    "description": "When an app stops: close its dashboard tab (always), or keep the tab for the next run (keep)"
                },
                "spring.dashboard.layout.fallbackSize": {
                    "type": "number",
                    "default": 75,
                    "minimum": 20,
                    "maximum": 100,
                    "description": "Width and height, in percent of the screen, of the float a bean, an endpoint, a relation or an nvim-dap stop opens in when the app has no source window, or there is no app"
                },
                "spring.dashboard.launch.defaults": {
                    "type": "object",
                    "default": {
                        "profiles": [],
                        "port": "",
                        "logLevel": "",
                        "logPackages": "",
                        "debugReport": false,
                        "vmArgs": [
                            "-Dcom.sun.management.jmxremote.authenticate=false",
                            "-Dcom.sun.management.jmxremote.ssl=false",
                            "-Dspring.jmx.enabled=true",
                            "-Dspring.application.admin.enabled=true",
                            "-Dmanagement.endpoints.jmx.exposure.include=*",
                            "-Dmanagement.endpoint.env.show-values=ALWAYS"
                        ],
                        "programArgs": [],
                        "envVars": {}
                    },
                    "description": "The launch settings under every app's own: profiles, server port (empty: the app's own, 0: random), root log level, per package log levels (com.example=DEBUG), debug report, JVM options, program arguments, environment. The default JVM options feed the live data, show-values=ALWAYS lets Spring Boot 3 report property values instead of ******. The JMX port, host and project name are added per run",
                    "properties": {
                        "profiles": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "port": {
                            "type": "string"
                        },
                        "logLevel": {
                            "type": "string"
                        },
                        "logPackages": {
                            "type": "string"
                        },
                        "debugReport": {
                            "type": "boolean"
                        },
                        "vmArgs": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "programArgs": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "envVars": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                },
                "spring.dashboard.launch.settings": {
                    "type": "object",
                    "default": {},
                    "description": "Launch settings per app name, used until the launch panel remembers others, on top of spring.dashboard.launch.defaults: JVM options are appended without exact duplicates, program arguments (programArgs) replace a default with the same option name, profiles are added, the environment variables (envVars) are merged per key, a single value replaces the default. { \"my-app\": { \"profiles\": [\"dev\"], \"port\": \"0\", \"vmArgs\": [\"-Xmx512m\"] } }",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "profiles": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "port": {
                                "type": "string"
                            },
                            "logLevel": {
                                "type": "string"
                            },
                            "logPackages": {
                                "type": "string"
                            },
                            "debugReport": {
                                "type": "boolean"
                            },
                            "vmArgs": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "programArgs": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "envVars": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "spring.dashboard.attach.defaults": {
                    "type": "object",
                    "default": {
                        "host": "localhost",
                        "jmxPort": "9010",
                        "debugPort": "5005",
                        "debugVmArgs": [
                            "-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:${debugPort}"
                        ],
                        "jmxVmArgs": [
                            "-Dcom.sun.management.jmxremote.port=${jmxPort}",
                            "-Dcom.sun.management.jmxremote.rmi.port=${jmxPort}",
                            "-Djava.rmi.server.hostname=${host}",
                            "-Dcom.sun.management.jmxremote.authenticate=false",
                            "-Dcom.sun.management.jmxremote.ssl=false",
                            "-Dspring.jmx.enabled=true",
                            "-Dspring.application.admin.enabled=true",
                            "-Dmanagement.endpoints.jmx.exposure.include=*",
                            "-Dmanagement.endpoint.env.show-values=ALWAYS"
                        ]
                    },
                    "description": "The attach settings under every project's own: host, JMX port of the live data and JDWP port of the debugger (an empty port skips that half), and the JVM options Copy app startup options gives for each half, with ${host}, ${jmxPort} and ${debugPort} filled in",
                    "properties": {
                        "host": {
                            "type": "string"
                        },
                        "jmxPort": {
                            "type": "string"
                        },
                        "debugPort": {
                            "type": "string"
                        },
                        "debugVmArgs": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "jmxVmArgs": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "spring.dashboard.attach.settings": {
                    "type": "object",
                    "default": {},
                    "description": "Attach settings per project name, on top of spring.dashboard.attach.defaults: a key that is set replaces the default. The host and ports are used until an attach to the project remembers others, the JVM options always come from the settings (here or spring.dashboard.attach.defaults). { \"orders-service\": { \"host\": \"10.0.0.5\", \"debugPort\": \"\" } }",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "host": {
                                "type": "string"
                            },
                            "jmxPort": {
                                "type": "string"
                            },
                            "debugPort": {
                                "type": "string"
                            },
                            "debugVmArgs": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "jmxVmArgs": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "commands": [
            {
                "command": "spring-boot-dashboard.refresh",
                "title": "Look for the local apps again",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.local.run",
                "title": "Run a local app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.local.runWithProfile",
                "title": "Run a local app with profiles",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.local.debug",
                "title": "Debug a local app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.local.debugWithProfile",
                "title": "Debug a local app with profiles",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.local.settings",
                "title": "Edit how a local app starts",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.local.dashboard",
                "title": "Show the dashboard tab of a local app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.local.attach",
                "title": "Attach the debugger to a local app started with Run",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.local.stop",
                "title": "Stop a local app",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.local.open",
                "title": "Open a local app in the browser",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.livedata.refresh",
                "title": "Reload the live data of the connected apps",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.list",
                "title": "List the Spring Boot apps of the workspace",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.navigate",
                "title": "Go to the bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.open",
                "title": "Open the bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showAll",
                "title": "Show all beans",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showDefined",
                "title": "Show only the beans defined in the workspace",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showDependencies",
                "title": "Show the dependencies of the bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showInjectedInto",
                "title": "Show where the bean is injected",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.bean.showHierarchy",
                "title": "Show the hierarchy of the bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.beans.find",
                "title": "Find a bean",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.staticData.refresh",
                "title": "Refresh the beans and mappings of the workspace",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.endpoint.navigate",
                "title": "Go to the endpoint",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.endpoint.open",
                "title": "Open the endpoint in the browser",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.mapping.showAll",
                "title": "Show all mappings",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.dashboard.mapping.showDefined",
                "title": "Show only the mappings defined in the workspace",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.mappings.find",
                "title": "Find a mapping",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring.properties.find",
                "title": "Find a property",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.remote.attach",
                "title": "Attach to a remote app: live data and debugger",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.remote.connect",
                "title": "Connect the live data of a boot-java.remote-apps entry",
                "category": "Spring Boot Dashboard"
            },
            {
                "command": "spring-boot-dashboard.app.remote.disconnect",
                "title": "Disconnect the live data of a remote app",
                "category": "Spring Boot Dashboard"
            }
        ]
    }
}
